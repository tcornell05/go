# Development environment configuration
# Source this file to set up your development environment

# Game settings
export GAME_DEBUG=true
export GAME_WINDOW_WIDTH=1024
export GAME_WINDOW_HEIGHT=768
export GAME_FPS_LIMIT=60

# Database settings
export GAME_DB_PATH=data/game.db
export GAME_DB_DEBUG=false

# Asset settings
export GAME_ASSETS_PATH=assets
export GAME_ASSETS_CACHE=true

# Development settings
export GAME_HOT_RELOAD=true
export GAME_SHOW_FPS=true
export GAME_SHOW_DEBUG_INFO=true

# Logging
export GAME_LOG_LEVEL=debug
export GAME_LOG_FILE=game.log

echo "🔧 Development environment loaded"
echo "Game debug mode: $GAME_DEBUG"
echo "Window size: ${GAME_WINDOW_WIDTH}x${GAME_WINDOW_HEIGHT}"